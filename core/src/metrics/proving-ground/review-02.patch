+/**
+ * Whether a lock file names a holder. `awsf status` asks this to say an attempt
+ * is busy without printing who holds it, and an unnamed or missing lock is not
+ * held.
+ */
+export async function isLockHeld(lockPath: string): Promise<boolean> {
+  const holder = readLockHolder(lockPath);
+  return holder !== null;
+}

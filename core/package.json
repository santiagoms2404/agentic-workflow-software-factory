{
  "name": "@awsf/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "0.34.14",
    "yaml": "2.6.1"
  },
  "scripts": {
    "typecheck": "npm --prefix .. run typecheck:core",
    "lint": "npm --prefix .. run lint",
    "test": "node -e \"const cp=require('node:child_process'),fs=require('node:fs'),path=require('node:path'),repoRoot=path.resolve(__dirname,'..'),expandDir=dir=>{const out=[];for(const ent of fs.readdirSync(dir,{withFileTypes:true})){const full=path.join(dir,ent.name);if(ent.isDirectory())out.push(...expandDir(full));else if(/\\.test\\.[mc]?[jt]s$/.test(ent.name))out.push(full);}return out;},args=process.argv.slice(1).map(a=>{const n=a.split(path.sep).join('/').replace(/^\\.\\//,'');return n.startsWith('core/')?n:fs.existsSync(path.join(repoRoot,'core',n))?'core/'+n:n}).flatMap(a=>{const full=path.join(repoRoot,a);return fs.existsSync(full)&&fs.statSync(full).isDirectory()?expandDir(full).map(f=>path.relative(repoRoot,f).split(path.sep).join('/')):[a];});process.exit(cp.spawnSync(process.execPath,['--experimental-strip-types','--test',...(args.length?args:['core/test/unit/**/*.test.ts'])],{cwd:repoRoot,stdio:'inherit'}).status??0)\""
  }
}
